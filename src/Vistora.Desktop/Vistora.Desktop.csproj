<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Nome do produto desde a 2.0.0; os projetos, os namespaces e a pasta de dados continuam Vistora. -->
    <AssemblyName>Jano</AssemblyName>
    <Product>Jano</Product>
    <AssemblyTitle>Jano</AssemblyTitle>
    <Version>2.0.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Branding/jano-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets/Branding/jano-icon.ico" />
    <Resource Include="Assets/Branding/jano-icon.ico" />
    <ProjectReference Include="../Vistora.Core/Vistora.Core.csproj" />
    <ProjectReference Include="../Vistora.Infrastructure/Vistora.Infrastructure.csproj" />
    <ProjectReference Include="../Vistora.Automation.Edge/Vistora.Automation.Edge.csproj" />
    <InternalsVisibleTo Include="Vistora.DesktopTests" />
  </ItemGroup>
</Project>
