<Window x:Class="Vistora.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Vistora.Desktop" Title="Vistora — Visitas preventivas" Width="1180" Height="820" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppSurfaceCardBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Vistora" FontFamily="Bahnschrift" FontSize="32" Margin="22,28,22,0"/>
          <TextBlock Text="Visitas preventivas" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="22,3,22,28"/>
          <ItemsControl x:Name="RailItems" IsTabStop="False">
            <ItemsControl.ItemTemplate><DataTemplate><RadioButton Style="{StaticResource RailNav}" GroupName="Rail" Content="{Binding Name}" Checked="PageChecked" Loaded="RailItemLoaded"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="22,0,22,28">
          <TextBlock x:Name="VersionLabel" Foreground="{DynamicResource AppTextMutedBrush}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,18">
        <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitle}"/>
        <TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
      </StackPanel>
      <TabControl x:Name="Pages" Grid.Row="1" BorderBrush="Transparent" Background="Transparent" Padding="0" IsTabStop="False">
        <TabControl.Resources><!-- O conteúdo herda o texto da aba, então a cor do tema vem daqui. --><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/></Style></TabControl.Resources>

        <!-- Executar visita -->
        <TabItem>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="RunSetup" IsEnabled="{Binding IsUnlocked}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel>
                  <TextBlock Text="Perfil da unidade" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="ProfilePicker" DisplayMemberPath="Name" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" Margin="0,6,0,8"/>
                  <StackPanel x:Name="PendingVisitPanel" Visibility="{Binding HasPendingVisits, Converter={StaticResource Visible}}">
                    <TextBlock Text="Visita pendente" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="PendingVisitPicker" ItemsSource="{Binding PendingVisits}" SelectedItem="{Binding SelectedPendingVisit}">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <TextBlock x:Name="PendingVisitNotice" Text="{Binding PendingNotice}" Foreground="{DynamicResource AppAttentionTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding HasPendingVisits, Converter={StaticResource Visible}}"/>
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,8,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TextBlock x:Name="SelectionSummary" Text="{Binding SelectionSummary}" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                  <DataGrid x:Name="FloorGrid" Grid.Row="1" ItemsSource="{Binding Floors}" SelectedItem="{Binding SelectedFloor}">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn x:Name="VisitColumn" Header="Visitar" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Checked="SelectionChanged" Unchecked="SelectionChanged" HorizontalAlignment="Left" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                      <DataGridTextColumn Header="Pavimento" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                      <DataGridTextColumn Header="Setor" Binding="{Binding Sector}" IsReadOnly="True" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
              </Grid>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="16" Margin="0,16,0,14">
              <StackPanel>
                <Grid x:Name="RunStatusRow" Margin="0,0,0,12" Visibility="{Binding HasStatusRow, Converter={StaticResource Visible}}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="RunStatus" Text="{Binding Status}" local:Tone.Foreground="{Binding StatusTone}" TextWrapping="Wrap" FontWeight="SemiBold" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite"/>
                  <TextBlock x:Name="RunCount" Grid.Column="1" Text="{Binding ProgressCount}" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="16,0,0,0" VerticalAlignment="Top"/>
                </Grid>
                <ProgressBar x:Name="RunProgress" Maximum="100" Value="{Binding Progress, Mode=OneWay}"/>
                <ScrollViewer x:Name="RunFloorsScroll" Visibility="{Binding HasRunFloors, Converter={StaticResource Visible}}" MaxHeight="96" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,12,0,0">
                  <ItemsControl x:Name="RunFloorList" ItemsSource="{Binding RunFloors}" IsTabStop="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,3,18,3" ToolTip="{Binding Message}">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="104"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Border Width="18" Height="4" Margin="0,0,2,0" CornerRadius="2" local:Tone.Stage="{Binding Stage}" local:Tone.Segment="1"/>
                            <Border Width="18" Height="4" Margin="0,0,2,0" CornerRadius="2" local:Tone.Stage="{Binding Stage}" local:Tone.Segment="2"/>
                            <Border Width="18" Height="4" Margin="0,0,2,0" CornerRadius="2" local:Tone.Stage="{Binding Stage}" local:Tone.Segment="3"/>
                            <Border Width="18" Height="4" CornerRadius="2" local:Tone.Stage="{Binding Stage}" local:Tone.Segment="4"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding StageLabel}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="{Binding IssueKey, TargetNullValue='—'}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
              <StackPanel x:Name="RunActions" Orientation="Horizontal" IsEnabled="{Binding IsUnlocked}">
                <Button x:Name="ExecuteButton" Style="{StaticResource Primary}" Content="{Binding ExecuteLabel}" Command="{Binding ExecuteCommand}"/>
                <Button x:Name="DiscardButton" Style="{StaticResource Danger}" Content="Descartar visita" Command="{Binding DiscardCommand}" Visibility="{Binding CanDiscard, Converter={StaticResource Visible}}"/>
                <Button x:Name="ConnectButton" Content="Verificar acesso ao Edge" Command="{Binding CheckAccessCommand}"/>
              </StackPanel>
              <Button x:Name="StopButton" Style="{StaticResource Danger}" Content="{Binding StopLabel}" Visibility="{Binding IsStopVisible, Converter={StaticResource Visible}}" Command="{Binding StopCommand}"/>
            </StackPanel>
          </Grid>
        </TabItem>

        <!-- Perfis e pavimentos -->
        <TabItem>
          <DockPanel>
            <StackPanel x:Name="ProfileActions" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16" IsEnabled="{Binding IsUnlocked}">
              <Button x:Name="NewProfileButton" Content="Novo perfil" Style="{StaticResource Primary}" Command="{Binding NewProfileCommand}"/>
              <Button x:Name="EditProfileButton" Content="Editar" Command="{Binding EditProfileCommand}"/>
              <Button x:Name="DeleteButton" Content="Excluir" Command="{Binding DeleteProfileCommand}"/>
            </StackPanel>
            <DataGrid x:Name="ProfilesGrid" IsReadOnly="True" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfileRow}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Perfil" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="2*"/>
                <DataGridTextColumn Header="Solicitante" Binding="{Binding ReporterName}" Width="2*"/>
                <DataGridTextColumn Header="Pavimentos" Binding="{Binding Floors.Count}" Width="110"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- Histórico -->
        <TabItem>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid x:Name="HistoryGrid" IsReadOnly="True" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistoryRun}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding DateLabel}" Width="160"/>
                <DataGridTextColumn Header="Perfil" Binding="{Binding ProfileName}" Width="*"/>
                <DataGridTemplateColumn Header="Resultado" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" local:Tone.RunState="{Binding State}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Progresso" Binding="{Binding ProgressLabel}" Width="150"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="HistoryRunMessage" Grid.Row="1" Text="{Binding HistoryMessage}" local:Tone.Foreground="{Binding HistoryMessageTone}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,0" Visibility="{Binding HasHistoryMessage, Converter={StaticResource Visible}}"/>
            <DataGrid x:Name="RunFloorGrid" Grid.Row="2" IsReadOnly="True" Margin="0,16,0,0" ItemsSource="{Binding HistoryFloors}" SelectedItem="{Binding SelectedHistoryFloor}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Pavimento" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Chamado" Binding="{Binding IssueKey}" Width="130"/>
                <DataGridTextColumn Header="Etapa" Binding="{Binding StageLabel}" Width="150"/>
                <DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="2*"/>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3" Margin="0,16,0,0">
              <WrapPanel>
                <Button x:Name="ExportLogButton" Content="Exportar log" Command="{Binding ExportLogCommand}"/>
                <Button x:Name="ClearHistoryButton" Style="{StaticResource Danger}" Content="Limpar histórico e pendências" Command="{Binding ClearHistoryCommand}"/>
              </WrapPanel>
              <TextBlock x:Name="HistoryStatus" Text="{Binding HistoryStatus}" local:Tone.Foreground="{Binding HistoryStatusTone}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
        </TabItem>

        <!-- Configurações -->
        <TabItem>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
              <StackPanel MaxWidth="660" HorizontalAlignment="Left">
              <StackPanel x:Name="SettingsPanel" IsEnabled="{Binding IsUnlocked}">
                <TextBlock Text="Endereço do Jira" Style="{StaticResource Label}"/><TextBox x:Name="JiraUrlBox" Text="{Binding JiraUrl, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Endereço do formulário de visita preventiva" Style="{StaticResource Label}"/><TextBox x:Name="PortalUrlBox" Text="{Binding PortalUrl, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Endereço da fila de atendimento" Style="{StaticResource Label}"/><TextBox x:Name="QueueUrlBox" Text="{Binding QueueUrl, UpdateSourceTrigger=PropertyChanged}"/>
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="Salvar configurações" Style="{StaticResource Primary}" Command="{Binding SaveSettingsCommand}"/>
                  <TextBlock x:Name="SettingsStatus" Text="{Binding SettingsStatus}" local:Tone.Foreground="{Binding SettingsStatusTone}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="320"/>
                </WrapPanel>
              </StackPanel>
              <!-- Fora do SettingsPanel: o tema pode mudar mesmo durante uma visita. -->
              <TextBlock Text="Aparência" Style="{StaticResource Section}" Margin="0,28,0,10"/>
              <CheckBox x:Name="DarkThemeBox" Content="Tema escuro" IsChecked="{Binding IsDarkTheme}"/>
              <TextBlock Text="Vale na hora e fica salvo neste computador." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
              </StackPanel>
            </ScrollViewer>
        </TabItem>
      </TabControl>
      <TextBlock x:Name="DiagnosticWarning" Grid.Row="2" Text="{Binding DiagnosticWarning}" TextWrapping="Wrap" Foreground="{DynamicResource AppAttentionTextBrush}" Margin="0,14,0,0" Visibility="{Binding HasDiagnosticWarning, Converter={StaticResource Visible}}"/>
    </Grid>
  </Grid>
</Window>
