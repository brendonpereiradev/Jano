<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:local="clr-namespace:Vistora.Desktop">

  <!--
    Moldura de JanoWindow: barra de título de 48 px com emblema, nome em Bahnschrift espaçada, subtítulo,
    troca de tema e botões da janela na mesma altura (padrão do Hermes). Os ícones vêm da Segoe MDL2 Assets,
    presente no Windows 10 e no 11.
  -->

  <Style x:Key="TitleBarButton" TargetType="Button">
    <Setter Property="Width" Value="46"/><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/><Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource AppNavSelectedBrush}"/></Trigger>
    </Style.Triggers>
  </Style>
  <!-- Fechar fica vermelho ao passar o mouse, como nas janelas do Windows. -->
  <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFC42B1C"/><Setter Property="Foreground" Value="White"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#FFB22A1C"/><Setter Property="Foreground" Value="White"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="TitleBarToolButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
    <Setter Property="Width" Value="44"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
  </Style>

  <Style x:Key="JanoWindowStyle" TargetType="local:JanoWindow">
    <Setter Property="Icon" Value="/Jano;component/Assets/Branding/jano-icon.ico"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource AppCanvasBackgroundBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:JanoWindow">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource AppLineStrongBrush}" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="48" Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppSurfaceCardBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ThemeButton" Style="{StaticResource TitleBarToolButton}" Command="local:JanoWindow.ToggleThemeCommand" Visibility="Collapsed"
                        Content="{DynamicResource AppThemeToggleGlyph}" ToolTip="{DynamicResource AppThemeToggleLabel}" AutomationProperties.Name="{DynamicResource AppThemeToggleLabel}"/>
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Command="{x:Static SystemCommands.MinimizeWindowCommand}" Content="&#xE921;" AutomationProperties.Name="Minimizar"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Command="{x:Static SystemCommands.MaximizeWindowCommand}" Content="&#xE922;" AutomationProperties.Name="Maximizar"/>
                <Button x:Name="RestoreButton" Style="{StaticResource TitleBarButton}" Command="{x:Static SystemCommands.RestoreWindowCommand}" Content="&#xE923;" AutomationProperties.Name="Restaurar" Visibility="Collapsed"/>
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Command="{x:Static SystemCommands.CloseWindowCommand}" Content="&#xE8BB;" AutomationProperties.Name="Fechar"/>
              </StackPanel>
              <!-- Fora do alcance do mouse, para a barra continuar arrastável por cima da marca. -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,12,0" IsHitTestVisible="False">
                <local:JanoEmblem IsAnimating="{TemplateBinding IsBusy}"/>
                <!-- JANO em caixa alta espaçada: o WPF não tem espaçamento entre letras, então cada letra é um texto. -->
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" TextElement.FontFamily="Bahnschrift" TextElement.FontSize="16" TextElement.FontWeight="SemiBold" AutomationProperties.Name="Jano">
                  <TextBlock Text="J"/><TextBlock Text="A" Margin="5,0,0,0"/><TextBlock Text="N" Margin="5,0,0,0"/><TextBlock Text="O" Margin="5,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="SubtitleText" Text="{TemplateBinding Subtitle}" Margin="12,0,0,1" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <AdornerDecorator><ContentPresenter/></AdornerDecorator>
        </DockPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="ShowThemeToggle" Value="True"><Setter TargetName="ThemeButton" Property="Visibility" Value="Visible"/></Trigger>
        <!-- Maximizada, a janela passa da tela pela espessura da borda do Windows; a margem traz o conteúdo de volta. -->
        <Trigger Property="WindowState" Value="Maximized">
          <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed"/><Setter TargetName="RestoreButton" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Frame" Property="BorderThickness" Value="0"/><Setter TargetName="Frame" Property="Margin" Value="{x:Static SystemParameters.WindowResizeBorderThickness}"/>
        </Trigger>
        <Trigger Property="ResizeMode" Value="CanMinimize"><Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="ResizeMode" Value="NoResize">
          <Setter TargetName="MinimizeButton" Property="Visibility" Value="Collapsed"/><Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="local:JanoWindow" BasedOn="{StaticResource JanoWindowStyle}"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
</ResourceDictionary>
