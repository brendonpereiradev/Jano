<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Marca do Jano. O emblema não muda com o tema: o ladrilho grafite é o mesmo do Hefesto, do Hermes e do Talos.
    Os desenhos repetem assets/brand/jano-mark.svg; ao mudar um, mude o outro.
  -->

  <Color x:Key="JanoTileTopColor">#FF1F2530</Color>
  <Color x:Key="JanoTileBottomColor">#FF101318</Color>
  <Color x:Key="JanoFrameColor">#664C8DF6</Color>
  <Color x:Key="JanoPortalColor">#FFE6E9EE</Color>
  <Color x:Key="JanoSillColor">#FF98A2B0</Color>
  <Color x:Key="JanoOpenColor">#FF4C8DF6</Color>
  <Color x:Key="JanoCloseColor">#FF7FD1BE</Color>

  <LinearGradientBrush x:Key="JanoTileBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="{StaticResource JanoTileTopColor}"/>
    <GradientStop Offset="1" Color="{StaticResource JanoTileBottomColor}"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="JanoFrameBrush" Color="{StaticResource JanoFrameColor}"/>
  <SolidColorBrush x:Key="JanoPortalBrush" Color="{StaticResource JanoPortalColor}"/>
  <SolidColorBrush x:Key="JanoSillBrush" Color="{StaticResource JanoSillColor}"/>
  <SolidColorBrush x:Key="JanoOpenBrush" Color="{StaticResource JanoOpenColor}"/>
  <SolidColorBrush x:Key="JanoCloseBrush" Color="{StaticResource JanoCloseColor}"/>

  <!-- Emblema completo (48 px ou mais): moldura, soleira, arco, pedra-chave e três pavimentos. -->
  <DrawingImage x:Key="JanoEmblemImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource JanoTileBrush}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,128,128" RadiusX="28" RadiusY="28"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource JanoFrameBrush}" Thickness="3"/>
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="1.5,1.5,125,125" RadiusX="26.5" RadiusY="26.5"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M28,108 H100">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource JanoSillBrush}" Thickness="5" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M38,100 V60 A26,26 0 0 1 90,60 V100">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource JanoPortalBrush}" Thickness="7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource JanoPortalBrush}">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="64,46" RadiusX="4" RadiusY="4"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M50,60 H58 M50,74 H58 M50,88 H58">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource JanoOpenBrush}" Thickness="6" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M70,60 H78 M70,74 H78 M70,88 H78">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource JanoCloseBrush}" Thickness="6" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Emblema de 24 a 32 px: arco mais grosso e dois pavimentos, sem moldura, soleira nem pedra-chave. -->
  <DrawingImage x:Key="JanoEmblemSmallImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource JanoTileBrush}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,128,128" RadiusX="28" RadiusY="28"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M36,100 V62 A28,28 0 0 1 92,62 V100">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource JanoPortalBrush}" Thickness="10" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M50,68 H56 M50,88 H56">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource JanoOpenBrush}" Thickness="10" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M72,68 H78 M72,88 H78">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource JanoCloseBrush}" Thickness="10" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Emblema de 16 px: arco grosso e um pavimento. -->
  <DrawingImage x:Key="JanoEmblemTinyImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource JanoTileBrush}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,128,128" RadiusX="24" RadiusY="24"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M32,104 V64 A32,32 0 0 1 96,64 V104">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource JanoPortalBrush}" Thickness="14" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M50,82 H54">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource JanoOpenBrush}" Thickness="14" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M74,82 H78">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource JanoCloseBrush}" Thickness="14" StartLineCap="Round" EndLineCap="Round"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
