<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    Tema claro: superfícies do Hefesto com o acento do Hermes, os mesmos valores de ThemeTokens.Light.xaml do Hermes.
    Os neutros ficam no matiz azul-ardósia: a janela é a mais escura, o campo vem depois e o painel é branco.
    ThemeTokens.Dark.xaml tem as mesmas chaves; Theme.Apply troca um pelo outro, então tudo o que muda com o tema
    é lido com DynamicResource (ou SetResourceReference no código).
  -->

  <!-- Janela e moldura (navegação lateral) -->
  <SolidColorBrush x:Key="AppCanvasBackgroundBrush" Color="#FFF1F4F8"/>
  <SolidColorBrush x:Key="AppChromeBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="AppNavHoverBrush" Color="#FFF1F4F8"/>
  <SolidColorBrush x:Key="AppNavSelectedBrush" Color="#FFEAF1FD"/>

  <!-- Painéis -->
  <SolidColorBrush x:Key="AppSurfaceCardBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="AppSurfaceCardBorderBrush" Color="#FFDDE3EB"/>
  <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="#FFEDF1F6"/>
  <SolidColorBrush x:Key="AppLineStrongBrush" Color="#FFC3CCD8"/>

  <!-- Campos de entrada: levemente afundados em relação ao painel branco -->
  <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#FFF7F9FC"/>
  <SolidColorBrush x:Key="AppInputBorderBrush" Color="#FFC3CCD8"/>
  <SolidColorBrush x:Key="AppInputHoverBorderBrush" Color="#FF9AA7B8"/>

  <!-- Texto -->
  <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FF111A2C"/>
  <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FF465569"/>
  <SolidColorBrush x:Key="AppTextMutedBrush" Color="#FF5F6E82"/>

  <!-- Acento -->
  <SolidColorBrush x:Key="AppBrandAccentBrush" Color="#FF2F6FE0"/>
  <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#FF2661CC"/>
  <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#FF2155B3"/>
  <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FF2155B3"/>
  <SolidColorBrush x:Key="AppFocusRingBrush" Color="#FF2F6FE0"/>

  <!-- Tabelas e listas -->
  <SolidColorBrush x:Key="AppTableHoverBrush" Color="#FFF7F9FC"/>
  <SolidColorBrush x:Key="AppTableRowSelectedBrush" Color="#FFEAF1FD"/>
  <SolidColorBrush x:Key="AppTableDividerBrush" Color="#FFE7ECF2"/>

  <!-- Trilho: fundo da barra de progresso, segmentos de etapa ainda não alcançados e barra de rolagem -->
  <SolidColorBrush x:Key="AppTrackBrush" Color="#FFE3E8EF"/>
  <SolidColorBrush x:Key="AppScrollThumbBrush" Color="#FFB9C4D2"/>

  <!-- Estados: o pincel pinta pontos e barras; o de texto tem contraste para letras sobre o painel -->
  <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF1F9D57"/>
  <SolidColorBrush x:Key="AppSuccessTextBrush" Color="#FF1F7A45"/>
  <SolidColorBrush x:Key="AppAttentionBrush" Color="#FFD29A12"/>
  <SolidColorBrush x:Key="AppAttentionTextBrush" Color="#FF8F5410"/>
  <SolidColorBrush x:Key="AppDangerBrush" Color="#FFC23636"/>
  <SolidColorBrush x:Key="AppDangerTextBrush" Color="#FFB42F2F"/>
  <SolidColorBrush x:Key="AppDangerForegroundBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#FFFCEEEE"/>

  <!-- Troca de tema na barra de título: o ícone e o texto mostram o tema para onde o botão leva -->
  <sys:String x:Key="AppThemeToggleGlyph">&#xE708;</sys:String>
  <sys:String x:Key="AppThemeToggleLabel">Usar tema escuro</sys:String>
</ResourceDictionary>
